# Copiar este archivo como .env y completar la contraseña de PostgreSQL.
# Usar valores sin comillas. Una barra invertida literal se escribe como \\.
MEDISHIFT_BD_URL=jdbc:postgresql://localhost:5432/MediShift
MEDISHIFT_BD_USUARIO=postgres
MEDISHIFT_BD_CLAVE=

# Mantener false en localhost HTTP; usar true con HTTPS.
MEDISHIFT_COOKIE_SEGURA=false

# Orígenes de navegador permitidos, separados por comas. En Render indica la URL de Vercel.
MEDISHIFT_ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Consulta de DNI desde el backend. Obtener el token en apisperu.com.
MEDISHIFT_APISPERU_TOKEN=
